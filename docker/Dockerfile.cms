# syntax=docker/dockerfile:1

FROM golang:1.23-alpine AS builder
RUN apk add --no-cache git ca-certificates tzdata
ENV GOTOOLCHAIN=auto
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/arguscms ./cmd/arguscms

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata wget
ENV TZ=Asia/Shanghai
WORKDIR /app
COPY --from=builder /out/arguscms /app/arguscms
COPY deploy/configs/arguscms.ini /config/arguscms.ini
VOLUME ["/data"]
EXPOSE 10000 15060/tcp 15060/udp
ENTRYPOINT ["/app/arguscms"]
CMD ["-config", "/config/arguscms.ini"]
