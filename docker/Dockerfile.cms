# syntax=docker/dockerfile:1

FROM golang:1.24-alpine AS builder
RUN apk add --no-cache git ca-certificates tzdata
ENV GOTOOLCHAIN=local
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . ./
# 空模块缓存下，sqlite 引用的 golang.org/x/sys/unix 需要 go.sum 里的 zip 校验。
RUN go get modernc.org/sqlite@v1.33.1 \
    && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/arguscms ./cmd/arguscms

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata wget redis ffmpeg
ENV TZ=Asia/Shanghai
WORKDIR /app
COPY --from=builder /out/arguscms /app/arguscms
COPY deploy/configs/arguscms.ini /config/arguscms.ini
VOLUME ["/data"]
EXPOSE 10002 15060/tcp 15060/udp 26380
ENTRYPOINT ["/app/arguscms"]
CMD ["-config", "/config/arguscms.ini"]
