# syntax=docker/dockerfile:1

FROM debian:bookworm-slim AS builder
RUN apt-get update && apt-get install -y --no-install-recommends g++ make ca-certificates libssl-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY sms ./sms
RUN mkdir -p /out \
    && make -C sms CXXFLAGS="-std=c++17 -O2 -Wall -pthread -static-libstdc++ -static-libgcc" \
    && cp sms/argussms /out/argussms

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates wget libssl3 \
    && rm -rf /var/lib/apt/lists/*
ENV TZ=Asia/Shanghai
WORKDIR /app
COPY --from=builder /out/argussms /app/argussms
COPY deploy/configs/argussms.ini /config/argussms.ini
VOLUME ["/data"]
EXPOSE 10001 554 1935
ENTRYPOINT ["/app/argussms"]
CMD ["-config", "/config/argussms.ini"]
