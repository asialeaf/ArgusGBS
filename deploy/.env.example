# 设备能访问到的本机 IP。会写进 SIP Contact 和收流 SDP。
ADVERTISE_IP=192.168.3.41

# 宿主机网络，端口写在服务配置里，不通过这里映射：
# 管理页 10000，信令 HTTP 10002，流媒体 HTTP 10001，Redis 26380，SIP 15060，RTP 30000-30249

# 阿里云 ACR。本地 docker login / pull 用；GitHub Actions 仍要在仓库 Secrets 里配同名四项。
ALIYUN_ACR_REGISTRY=registry.cn-hangzhou.aliyuncs.com
ALIYUN_ACR_NAMESPACE=arguslive
ALIYUN_ACR_USER=asialeaf
ALIYUN_ACR_PASSWORD=Yyz@201314.
# 镜像前缀 = REGISTRY/NAMESPACE，不要带末尾斜杠
ACR_IMAGE_PREFIX=registry.cn-hangzhou.aliyuncs.com/arguslive
IMAGE_TAG=latest
