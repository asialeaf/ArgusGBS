# 设备能访问到的本机 IP。会写进 SIP Contact 和收流 SDP。
ADVERTISE_IP=192.168.1.10

# 管理页静态文件。可指向 GB28181-Server 的编译结果，或 LiveCMS 安装包里的 www
WWW_DIR=../../GB28181-Server/www

CMS_HTTP_PORT=10000
SMS_HTTP_PORT=10001
SIP_PORT=15060
RTP_PORT_RANGE=30000-30249

# ACR 镜像前缀，不含仓库名。例：registry.cn-hangzhou.aliyuncs.com/your-namespace
ACR_IMAGE_PREFIX=registry.cn-hangzhou.aliyuncs.com/your-namespace
IMAGE_TAG=latest
